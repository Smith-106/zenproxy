# =============================================================================
# zenproxy 环境变量模板 —— 默认部署路线（挂在已存在的 new-api 旁边）
# =============================================================================
#
# 用法：
#   cp .env.example .env
#   chmod 600 .env            # 里面全是密钥
#   逐项替换下面 4 个 REPLACE_WITH_* 占位值，再 docker compose up -d
#
# ⚠ 本文件只有「这条路线真正需要的」变量，一个都不多。
#   docker-compose.yml 用 environment: 逐项注入，不用 env_file，所以 .env 文件本身
#   不会进容器 —— 只有下面这 4 个名字（且只有它们）会出现在容器的环境变量表里。
#   要加别的服务的变量请另开文件，别往这里塞。
#
# ⚠ 语法约定：值不加引号、不含空格、不含 #（compose 的 .env 解析器对这些敏感）。
#   密钥用 hex 生成就没有这些字符。
#
# ⚠ 绝对不要把自己填好的 .env 提交到 git；deploy/.gitignore 已忽略 .env。
#   下面所有值都是占位符，不含任何真实凭据。

# -----------------------------------------------------------------------------
# 1. 管理接口令牌
#    用途：/admin/ 控制台与 /admin/api/* 的鉴权（X-Admin-Token / Bearer / ?token=）。
#          config.yaml 里写的是 ${ZEN_ADMIN_TOKEN}。
#    生成：openssl rand -hex 32
#    不设或留空的后果：zenproxy 启动即报 "server.admin_token is empty" 退出。
# -----------------------------------------------------------------------------
ZEN_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN

# -----------------------------------------------------------------------------
# 2. Resin 代理池令牌
#    用途：拼 Resin 的粘性身份，格式 <Platform>.<Account>:<token>@<host>。
#          config.yaml 里写的是 ${RESIN_PROXY_TOKEN}。
#    来源：★ 这是 Resin 自己生成/配置的那个代理密码，不是你 random 出来的。
#          目标宿主机上 resin 容器已经在跑，直接从它的环境变量里读（见 README 第四节）：
#            docker inspect resin --format '{{range .Config.Env}}{{println .}}{{end}}' \
#              | grep '^RESIN_PROXY_TOKEN='
#    不设或留空的后果：proxies.resin.enabled 为 true 时启动即失败。
# -----------------------------------------------------------------------------
RESIN_PROXY_TOKEN=REPLACE_WITH_RESIN_TOKEN

# -----------------------------------------------------------------------------
# 3./4. 上游账号 API Key（一个账号一把）
#    用途：zenproxy 按账号注入到上游请求的 Authorization 头，覆盖客户端带来的那把。
#          config.yaml 里写的是 ${ZEN_KEY_01} / ${ZEN_KEY_02}。
#    来源：上游账号后台复制，不要自己生成。
#    变量没定义时 ${ZEN_KEY_01} 会原样保留，zenproxy 启动即报
#    "still contains an unexpanded ${ZEN_KEY_01}"，并指出是哪个账号 —— 设计如此。
#    账号数不是 2 时：同步改 config.yaml 的 accounts 段与 docker-compose.yml 的
#    environment 段，三处名字（变量名、账号 id、渠道 Base URL 的路径段）保持一致。
# -----------------------------------------------------------------------------
ZEN_KEY_01=REPLACE_WITH_UPSTREAM_ACCOUNT_1_KEY
ZEN_KEY_02=REPLACE_WITH_UPSTREAM_ACCOUNT_2_KEY

# -----------------------------------------------------------------------------
# 【仅备选路线需要】LiteLLM + Postgres
#   走默认路线（new-api）的人：下面这 5 行与你无关，全部留注释即可。
#
#   docker-compose.litellm.yml 里这 5 个变量用的是 ${VAR:?未设置，检查 .env}，
#   即**缺失就硬失败**。所以走备选路线时，光在 .env 里留注释是不够的 ——
#   必须把用到的那几行取消注释并填上，否则 docker compose 直接报：
#     error while interpolating services.litellm.environment.DATABASE_URL:
#     required variable DATABASE_URL is missing a value: DATABASE_URL 未设置，检查 .env
#   这是刻意设计的：宁可起不来，也不要带着空密码把 Postgres 暴露出去。
# -----------------------------------------------------------------------------
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
# POSTGRES_DB=litellm
# DATABASE_URL=postgresql://litellm:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@postgres:5432/litellm
# LITELLM_MASTER_KEY=REPLACE_WITH_A_LITELLM_MASTER_KEY
#
# ⚠ DATABASE_URL 里的密码必须和上面的 POSTGRES_PASSWORD 一致（两处手改，容易漏）。
